{
  "scope": "aux4",
  "name": "repository",
  "version": "1.2.0",
  "description": "Simplified aux4 database",
  "tags": [
    "aux4",
    "database",
    "repository"
  ],
  "system": [
    [
      "test:jq",
      "brew:jq",
      "apt:jq",
      "linux:jq"
    ],
    [
      "test:sqlite3",
      "brew:sqlite",
      "apt:sqlite3"
    ]
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "repository",
          "execute": [
            "profile:repository"
          ],
          "help": {
            "text": "Simplified aux4 database"
          }
        }
      ]
    },
    {
      "name": "repository",
      "commands": [
        {
          "name": "init",
          "private": true,
          "execute": [
            "${packageDir}/aux4-repository init values(db, repository)"
          ],
          "help": {
            "text": "Initialize the aux4 repository",
            "variables": [
              {
                "name": "db",
                "text": "The database to initialize",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to initialize",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "write",
          "execute": [
            "stdin:${packageDir}/aux4-repository write values(db, repository, id, data, metadata, ttl, access)"
          ],
          "help": {
            "text": "Write to the aux4 repository",
            "variables": [
              {
                "name": "db",
                "text": "The database to write to",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to write to",
                "arg": true
              },
              {
                "name": "id",
                "text": "The id to write to the repository",
                "default": ""
              },
              {
                "name": "data",
                "text": "The data to write to the repository (JSON string)",
                "default": ""
              },
              {
                "name": "metadata",
                "text": "Optional metadata to store with the record",
                "default": "{}"
              },
              {
                "name": "ttl",
                "text": "Time-to-live in seconds; stored as an absolute expiry epoch under metadata.ttl. Expired records are hidden from read/find and removed by clean",
                "default": ""
              },
              {
                "name": "access",
                "text": "Comma-separated access labels; stored as a JSON array under metadata.access. When set, the record is only visible to read/find callers passing a matching --access label (or --all true). When empty, the record is public.",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "read",
          "execute": [
            "aux4 repository init --db ${db} --repository ${repository}",
            "set:tmpFile=!mktemp /tmp/aux4_read.XXXXXX",
            "set:visClause=!aux4 repository visibility-clause --includeExpired ${includeExpired} --all ${all} --access value(access)",
            "set:idClause=!if(id==) && echo '1=1' || echo \"id = value(id)\"",
            "set:sqlFile=!mktemp /tmp/aux4_read_sql.XXXXXX",
            "file:${sqlFile}:SELECT id, data, metadata, created_at, updated_at FROM ( SELECT id, data, metadata, created_at, updated_at FROM ${repository} WHERE 1=1 ${visClause} ) WHERE ${idClause};",
            "sqlite3 -json ${db} < ${sqlFile} > ${tmpFile}",
            "if(raw==true) && if [ -s ${tmpFile} ]; then cat ${tmpFile} | jq 'map(. as $$row | ({\"id\": $$row.id} + ($$row.data | fromjson)) + {\"__metadata\": (($$row.metadata | fromjson) + {\"createdAt\": $$row.created_at, \"updatedAt\": $$row.updated_at})})'; else echo '[]'; fi || true",
            "if(raw!=true) && if [ -s ${tmpFile} ]; then cat ${tmpFile} | jq 'map(. as $$row | ({\"id\": $$row.id} + ($$row.data | fromjson)))'; else echo '[]'; fi || true",
            "rm -f ${tmpFile} ${sqlFile}"
          ],
          "help": {
            "text": "Read from the aux4 repository",
            "variables": [
              {
                "name": "db",
                "text": "The database to read from",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to read from",
                "arg": true
              },
              {
                "name": "id",
                "text": "The id to read from the repository",
                "default": ""
              },
              {
                "name": "raw",
                "text": "Include metadata in the output",
                "default": "false"
              },
              {
                "name": "includeExpired",
                "text": "Include records whose ttl has expired (hidden by default)",
                "default": "false"
              },
              {
                "name": "access",
                "text": "Comma-separated access labels held by the caller. Public records (written without --access) are always visible; restricted records are visible only when one of their labels matches. With no --access, only public records are returned.",
                "default": ""
              },
              {
                "name": "all",
                "text": "Bypass access filtering and return every record regardless of its access labels (public and restricted). Defaults to false.",
                "default": "false"
              }
            ]
          }
        },
        {
          "name": "find",
          "execute": [
            "${packageDir}/aux4-repository find values(db, repository, expr, raw, includeExpired, access, all)"
          ],
          "help": {
            "text": "Find in the aux4 repository using SQL expressions",
            "variables": [
              {
                "name": "db",
                "text": "The database to find in",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to find in",
                "arg": true
              },
              {
                "name": "expr",
                "text": "SQL expression for filtering (e.g., 'age > 30 and name like \"%John%\"')"
              },
              {
                "name": "raw",
                "text": "Include metadata in the output",
                "default": "false"
              },
              {
                "name": "includeExpired",
                "text": "Include records whose ttl has expired (hidden by default)",
                "default": "false"
              },
              {
                "name": "access",
                "text": "Comma-separated access labels held by the caller. Public records (written without --access) are always visible; restricted records are visible only when one of their labels matches. With no --access, only public records are returned. Applied on top of the --expr filter.",
                "default": ""
              },
              {
                "name": "all",
                "text": "Bypass access filtering and return every record regardless of its access labels (public and restricted). Defaults to false.",
                "default": "false"
              }
            ]
          }
        },
        {
          "name": "delete",
          "execute": [
            "aux4 repository init --db ${db} --repository ${repository}",
            "set:ids_json=value(id*)",
            "echo ${ids_json} | sed 's/\\[//' | sed 's/\\]//' | sed \"s/\\\"/'/g\"",
            "sqlite3 ${db} \"DELETE FROM ${repository} WHERE id IN ($response)\""
          ],
          "help": {
            "text": "Delete from the aux4 repository",
            "variables": [
              {
                "name": "db",
                "text": "The database to delete from",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to delete from",
                "arg": true
              },
              {
                "name": "id",
                "text": "The id to delete from the repository",
                "multiple": true
              }
            ]
          }
        },
        {
          "name": "truncate",
          "execute": [
            "confirm:Are you sure you want to truncate the repository '${repository}'? This will delete all records.",
            "aux4 repository init --db ${db} --repository ${repository}",
            "sqlite3 ${db} \"DELETE FROM ${repository}\""
          ],
          "help": {
            "text": "Truncate the aux4 repository (delete all records)",
            "variables": [
              {
                "name": "db",
                "text": "The database to truncate",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to truncate",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "clean",
          "execute": [
            "set:cleanScript=!mktemp /tmp/aux4_clean.XXXXXX",
            "cat ${packageDir}/sql/clean.sql | sqlite3 ${db} > ${cleanScript}",
            "sqlite3 ${db} < ${cleanScript}",
            "rm -f ${cleanScript}"
          ],
          "help": {
            "text": "Remove expired records (ttl in the past) from every repository in the database",
            "variables": [
              {
                "name": "db",
                "text": "The database to clean",
                "default": ".local.db"
              }
            ]
          }
        },
        {
          "name": "visibility-clause",
          "private": true,
          "execute": [
            "jq -rn --arg access value(access) --arg all \"${all}\" --arg includeExpired \"${includeExpired}\" '(if $$includeExpired == \"true\" then \"\" else \"AND (json_extract(metadata,\\u0027$.ttl\\u0027) IS NULL OR json_extract(metadata,\\u0027$.ttl\\u0027) > strftime(\\u0027%s\\u0027,\\u0027now\\u0027) + 0)\" end) as $$ttl | (if $$all == \"true\" then \"\" elif $$access == \"\" then \"AND json_extract(metadata,\\u0027$.access\\u0027) IS NULL\" else ($$access | split(\",\") | map(\"\\u0027\" + gsub(\"\\u0027\";\"\\u0027\\u0027\") + \"\\u0027\") | join(\",\")) as $$list | \"AND (json_extract(metadata,\\u0027$.access\\u0027) IS NULL OR EXISTS (SELECT 1 FROM json_each(metadata,\\u0027$.access\\u0027) WHERE value IN (\" + $$list + \")))\" end) as $$acc | $$ttl + \" \" + $$acc'"
          ],
          "help": {
            "text": "Emit the combined hidden WHERE predicate (ttl visibility + access restriction) as a single string for read/find. Not for direct use.",
            "variables": [
              {
                "name": "includeExpired",
                "text": "When true, omit the ttl predicate (show expired records)",
                "default": "false"
              },
              {
                "name": "all",
                "text": "When true, omit the access predicate (bypass access filtering)",
                "default": "false"
              },
              {
                "name": "access",
                "text": "Comma-separated caller access labels used to build the safely-quoted IN list",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "translate-where",
          "private": true,
          "execute": [
            "profile:repository:translate-where"
          ],
          "help": {
            "text": "Internal platform-specific helpers (where-clause translation). Not for direct use."
          }
        }
      ]
    },
    {
      "name": "repository:translate-where",
      "commands": [
        {
          "name": "run",
          "private": true,
          "execute": [
            "sed -i '' -E \"s/([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*(=|!=|<>|<=|>=|<|>|like|not like)[[:space:]]*('[^']*'|[^[:space:]]+)/json_extract(data, '$.\\1') \\2 \\3/gi\" ${file}"
          ],
          "help": {
            "text": "Rewrite a where-clause file in place, translating bare column references into json_extract(data, '$.col') (BSD sed default; the linux dist override supplies the GNU form)",
            "variables": [
              {
                "name": "file",
                "text": "The where-clause file to translate in place"
              }
            ]
          }
        }
      ]
    }
  ]
}
