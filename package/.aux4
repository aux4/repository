{
  "scope": "aux4",
  "name": "repository",
  "version": "1.3.8",
  "description": "Simplified aux4 database",
  "license": "Apache-2.0",
  "tags": [
    "aux4",
    "database",
    "repository"
  ],
  "dependencies": [
    "aux4/render"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "repository",
          "execute": [
            "profile:repository"
          ],
          "help": {
            "text": "Simplified aux4 database"
          }
        }
      ]
    },
    {
      "name": "repository",
      "commands": [
        {
          "name": "init",
          "private": true,
          "execute": [
            "${packageDir}/aux4-repository init values(db, repository)"
          ],
          "help": {
            "text": "Initialize the aux4 repository",
            "variables": [
              {
                "name": "db",
                "text": "The database to initialize",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to initialize",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "write",
          "execute": [
            "stdin:${packageDir}/aux4-repository write values(db, repository, id, data, metadata, ttl, access)"
          ],
          "help": {
            "text": "Write to the aux4 repository",
            "variables": [
              {
                "name": "db",
                "text": "The database to write to",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to write to",
                "arg": true
              },
              {
                "name": "id",
                "text": "The id to write to the repository",
                "default": ""
              },
              {
                "name": "data",
                "text": "The data to write to the repository (JSON string)",
                "default": ""
              },
              {
                "name": "metadata",
                "text": "Optional metadata to store with the record",
                "default": "{}"
              },
              {
                "name": "ttl",
                "text": "Time-to-live in seconds; stored as an absolute expiry epoch under metadata.ttl. Expired records are hidden from read/find and removed by clean",
                "default": ""
              },
              {
                "name": "access",
                "text": "Comma-separated access labels; stored as a JSON array under metadata.access. When set, the record is only visible to read/find callers passing a matching --access label (or --all true). When empty, the record is public.",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "claim",
          "execute": [
            "stdin:${packageDir}/aux4-repository claim values(db, repository, id, data, ttl)"
          ],
          "help": {
            "text": "Atomically claim an id in the aux4 repository, failing if it is already held",
            "variables": [
              {
                "name": "db",
                "text": "The database to write to",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to claim in",
                "arg": true
              },
              {
                "name": "id",
                "text": "The id to claim",
                "default": ""
              },
              {
                "name": "data",
                "text": "The data to write to the repository (JSON string)",
                "default": ""
              },
              {
                "name": "ttl",
                "text": "Time-to-live in seconds; stored as an absolute expiry epoch under metadata.ttl. A claim past its ttl counts as absent and can be re-claimed (atomically replacing it)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "lease",
          "execute": [
            "${packageDir}/aux4-repository lease values(db, repository, expr, group, ttl, owner, raw)"
          ],
          "help": {
            "text": "Atomically lease the oldest eligible record in a repository (visibility-timeout based, optionally serialized per group)",
            "variables": [
              {
                "name": "db",
                "text": "The database to lease from",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to lease from",
                "arg": true
              },
              {
                "name": "expr",
                "text": "SQL expression narrowing which records are eligible (same syntax as find --expr)",
                "default": ""
              },
              {
                "name": "group",
                "text": "Data field name to serialize on: only one LIVE lease at a time per distinct value of this field",
                "default": ""
              },
              {
                "name": "ttl",
                "text": "Visibility timeout in seconds. The lease expires on its own once this elapses; an expired lease is free for the next caller to re-lease",
                "default": ""
              },
              {
                "name": "owner",
                "text": "Opaque identifier of the leasing caller, stored as data.leaseOwner",
                "default": ""
              },
              {
                "name": "raw",
                "text": "Include metadata in the output",
                "default": "false"
              }
            ]
          }
        },
        {
          "name": "renew",
          "execute": [
            "${packageDir}/aux4-repository renew values(db, repository, id, ttl)"
          ],
          "help": {
            "text": "Extend a still-live lease on a specific record (heartbeat), without re-leasing it",
            "variables": [
              {
                "name": "db",
                "text": "The database holding the leased record",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository holding the leased record",
                "arg": true
              },
              {
                "name": "id",
                "text": "The id of the leased record to renew (required)",
                "default": ""
              },
              {
                "name": "ttl",
                "text": "New visibility timeout in seconds, counted from now (required)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "read",
          "execute": [
            "nout:${packageDir}/aux4-repository read values(db, repository, id, raw, includeExpired, access, all, sort, limit, offset, select)"
          ],
          "render": {
            "tty": "aux4 render table"
          },
          "help": {
            "text": "Read from the aux4 repository",
            "variables": [
              {
                "name": "db",
                "text": "The database to read from",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to read from",
                "arg": true
              },
              {
                "name": "id",
                "text": "The id to read from the repository",
                "default": ""
              },
              {
                "name": "raw",
                "text": "Include metadata in the output",
                "default": "false"
              },
              {
                "name": "includeExpired",
                "text": "Include records whose ttl has expired (hidden by default)",
                "default": "false"
              },
              {
                "name": "access",
                "text": "Comma-separated access labels held by the caller. Public records (written without --access) are always visible; restricted records are visible only when one of their labels matches. With no --access, only public records are returned.",
                "default": ""
              },
              {
                "name": "all",
                "text": "Bypass access filtering and return every record regardless of its access labels (public and restricted). Defaults to false.",
                "default": "false"
              },
              {
                "name": "sort",
                "text": "Comma-separated list of 'field [asc|desc]' clauses (asc is the default), e.g. 'age desc, name'. Data fields use dotted paths (specs.wireless); id, createdAt, and updatedAt sort by the record's id and timestamps.",
                "default": ""
              },
              {
                "name": "limit",
                "text": "Maximum number of records to return (non-negative integer). Empty returns all matching records.",
                "default": ""
              },
              {
                "name": "offset",
                "text": "Number of leading records to skip for pagination (non-negative integer). Empty starts from the first record.",
                "default": ""
              },
              {
                "name": "select",
                "text": "Comma-separated list of fields to project, in the requested order (e.g. 'first_name, last_name, age'). id is always included first; absent fields are omitted; dotted paths (address.city) navigate nested objects and are keyed by the path as written. Empty returns all fields.",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "find",
          "execute": [
            "nout:${packageDir}/aux4-repository find values(db, repository, expr, raw, includeExpired, access, all, sort, limit, offset, select)"
          ],
          "render": {
            "tty": "aux4 render table"
          },
          "help": {
            "text": "Find in the aux4 repository using SQL expressions",
            "variables": [
              {
                "name": "db",
                "text": "The database to find in",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to find in",
                "arg": true
              },
              {
                "name": "expr",
                "text": "SQL expression for filtering (e.g., 'age > 30 and name like \"%John%\"')"
              },
              {
                "name": "raw",
                "text": "Include metadata in the output",
                "default": "false"
              },
              {
                "name": "includeExpired",
                "text": "Include records whose ttl has expired (hidden by default)",
                "default": "false"
              },
              {
                "name": "access",
                "text": "Comma-separated access labels held by the caller. Public records (written without --access) are always visible; restricted records are visible only when one of their labels matches. With no --access, only public records are returned. Applied on top of the --expr filter.",
                "default": ""
              },
              {
                "name": "all",
                "text": "Bypass access filtering and return every record regardless of its access labels (public and restricted). Defaults to false.",
                "default": "false"
              },
              {
                "name": "sort",
                "text": "Comma-separated list of 'field [asc|desc]' clauses (asc is the default), e.g. 'age desc, name'. Data fields use dotted paths (specs.wireless); id, createdAt, and updatedAt sort by the record's id and timestamps.",
                "default": ""
              },
              {
                "name": "limit",
                "text": "Maximum number of records to return (non-negative integer). Empty returns all matching records.",
                "default": ""
              },
              {
                "name": "offset",
                "text": "Number of leading records to skip for pagination (non-negative integer). Empty starts from the first record.",
                "default": ""
              },
              {
                "name": "select",
                "text": "Comma-separated list of fields to project, in the requested order (e.g. 'first_name, last_name, age'). id is always included first; absent fields are omitted; dotted paths (address.city) navigate nested objects and are keyed by the path as written. Empty returns all fields.",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "count",
          "execute": [
            "${packageDir}/aux4-repository count values(db, repository, expr, access, all, includeExpired)"
          ],
          "help": {
            "text": "Count records in the aux4 repository, optionally filtered by a SQL expression",
            "variables": [
              {
                "name": "db",
                "text": "The database to count in",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to count in",
                "arg": true
              },
              {
                "name": "expr",
                "text": "Optional SQL expression for filtering (same syntax as find). Empty counts all visible records.",
                "default": ""
              },
              {
                "name": "access",
                "text": "Comma-separated access labels held by the caller. Public records are always counted; restricted records are counted only when one of their labels matches. With no --access, only public records are counted.",
                "default": ""
              },
              {
                "name": "all",
                "text": "Bypass access filtering and count every record regardless of its access labels. Defaults to false.",
                "default": "false"
              },
              {
                "name": "includeExpired",
                "text": "Include records whose ttl has expired (hidden by default).",
                "default": "false"
              }
            ]
          }
        },
        {
          "name": "patch",
          "execute": [
            "stdin:${packageDir}/aux4-repository patch values(db, repository, id, data, increment)"
          ],
          "help": {
            "text": "Merge-update an existing record's data (shallow top-level merge; update-only, not an upsert). Optionally bumps numeric fields by 1 server-side",
            "variables": [
              {
                "name": "db",
                "text": "The database to patch in",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to patch in",
                "arg": true
              },
              {
                "name": "id",
                "text": "The id of the existing record to patch (required). Patch errors if the id does not exist.",
                "default": ""
              },
              {
                "name": "data",
                "text": "JSON patch payload (or piped via stdin, unless --increment is used with no data). Top-level keys set/override the record's data; keys not mentioned are preserved. Any id field in the payload is ignored.",
                "default": ""
              },
              {
                "name": "increment",
                "text": "Comma-separated list of numeric fields to bump by 1 (missing or non-numeric treated as 0), applied after the --data merge. Lets a caller atomically increment a counter (e.g. a retry count) without computing the arithmetic itself",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "touch",
          "execute": [
            "${packageDir}/aux4-repository touch values(db, repository, id, ttl, access)"
          ],
          "help": {
            "text": "Update an existing record's ttl and/or access metadata without changing its data (update-only)",
            "variables": [
              {
                "name": "db",
                "text": "The database to touch in",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to touch in",
                "arg": true
              },
              {
                "name": "id",
                "text": "The id of the existing record to touch (required). Touch errors if the id does not exist.",
                "default": ""
              },
              {
                "name": "ttl",
                "text": "New time-to-live in seconds; stored as an absolute expiry epoch under metadata.ttl. At least one of --ttl / --access must be provided.",
                "default": ""
              },
              {
                "name": "access",
                "text": "New comma-separated access labels; replaces metadata.access. At least one of --ttl / --access must be provided.",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "import",
          "execute": [
            "stdin:${packageDir}/aux4-repository import values(db, repository, ttl, access)"
          ],
          "help": {
            "text": "Bulk-upsert a JSON array of records from stdin in a single transaction",
            "variables": [
              {
                "name": "db",
                "text": "The database to import into",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to import into",
                "arg": true
              },
              {
                "name": "ttl",
                "text": "Optional time-to-live in seconds applied uniformly to every imported record (stored as an absolute expiry epoch under metadata.ttl).",
                "default": ""
              },
              {
                "name": "access",
                "text": "Optional comma-separated access labels applied uniformly to every imported record (stored under metadata.access).",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "list",
          "execute": [
            "${packageDir}/aux4-repository list values(db)"
          ],
          "help": {
            "text": "List the repositories (tables) in the database as a JSON array",
            "variables": [
              {
                "name": "db",
                "text": "The database to list repositories from",
                "default": ".local.db"
              }
            ]
          }
        },
        {
          "name": "drop",
          "execute": [
            "confirm:Are you sure you want to drop the repository '${repository}'? This removes the table, its schema and all its records.",
            "${packageDir}/aux4-repository drop values(db, repository)"
          ],
          "help": {
            "text": "Drop an entire repository (table + schema + data); idempotent for a non-existent repository",
            "variables": [
              {
                "name": "db",
                "text": "The database to drop the repository from",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to drop",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "delete",
          "execute": [
            "${packageDir}/aux4-repository delete values(db, repository) value(id*)"
          ],
          "help": {
            "text": "Delete from the aux4 repository",
            "variables": [
              {
                "name": "db",
                "text": "The database to delete from",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to delete from",
                "arg": true
              },
              {
                "name": "id",
                "text": "The id to delete from the repository",
                "multiple": true
              }
            ]
          }
        },
        {
          "name": "truncate",
          "execute": [
            "confirm:Are you sure you want to truncate the repository '${repository}'? This will delete all records.",
            "${packageDir}/aux4-repository truncate values(db, repository)"
          ],
          "help": {
            "text": "Truncate the aux4 repository (delete all records)",
            "variables": [
              {
                "name": "db",
                "text": "The database to truncate",
                "default": ".local.db"
              },
              {
                "name": "repository",
                "text": "The name of the repository to truncate",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "clean",
          "execute": [
            "${packageDir}/aux4-repository clean values(db)"
          ],
          "help": {
            "text": "Remove expired records (ttl in the past) from every repository in the database",
            "variables": [
              {
                "name": "db",
                "text": "The database to clean",
                "default": ".local.db"
              }
            ]
          }
        }
      ]
    }
  ]
}
