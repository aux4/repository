{
  "platform": "linux",
  "profiles": [
    {
      "name": "repository-internal",
      "commands": [
        {
          "name": "translate-where",
          "private": true,
          "execute": [
            "sed -i -E \"s/([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*(=|!=|<>|<=|>=|<|>|like|not like)[[:space:]]*('[^']*'|[^[:space:]]+)/json_extract(data, '$.\\1') \\2 \\3/gi\" ${file}"
          ],
          "help": {
            "text": "Rewrite a where-clause file in place, translating bare column references into json_extract(data, '$.col') (GNU sed variant for Linux)",
            "variables": [
              {
                "name": "file",
                "text": "The where-clause file to translate in place"
              }
            ]
          }
        }
      ]
    }
  ]
}
